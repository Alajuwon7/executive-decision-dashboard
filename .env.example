# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic — powers the OODA Decision Engine and What Would It Take cards
ANTHROPIC_API_KEY=sk-ant-your_key_here

# QuickBooks (Phase 5A) — get from developer.intuit.com
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/quickbooks-callback
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=your_webhook_verifier_token

# Token encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=your_32_byte_base64_key

# Internal cron token — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CRON_TOKEN=your_cron_token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
